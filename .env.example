# Public address of the site (absolute URLs in metadata). Default: https://openrac.dev
SITE_URL=https://openrac.dev
# Folder with the card backdrops (rac1-bg.webp, rac1us-bg.webp, gc-bg.webp, uya-bg.webp, deadlocked-bg.webp, going-mobile-bg.webp, size-matters-bg.webp, sac-bg.webp). Default: ./public/img
# IMAGE_DIR=
# Set in production. Raises the GitHub API rate limit (60 an hour without it) for the "Recent activity" feed and the
# Download panel; a fine-grained token with no permissions is enough. Stays on the server.
# GITHUB_TOKEN=
