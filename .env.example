# Public address of the site (absolute URLs in metadata). Default: https://openrac.dev
SITE_URL=https://openrac.dev
# Folder with the card backdrops (rac1-bg.webp, rac1us-bg.webp, gc-bg.webp, uya-bg.webp, deadlocked-bg.webp, going-mobile-bg.webp, size-matters-bg.webp, sac-bg.webp). Default: ./public/img
# IMAGE_DIR=
# GitHub access, best through the OpenRAC GitHub App: nothing to renew (README, "GitHub access").
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/path/to/openrac-github-app.pem
# GITHUB_APP_INSTALLATION_ID=     (optional: found from GITHUB_APP_ORG, default OpenRAC)
# Or a personal token. Raises the GitHub API rate limit (60 an hour without it) for the "Recent activity" feed, the
# Download panel and the /mods/submit checklist, and lets mod pages show their latest comments (GitHub's GraphQL API
# needs a token). A fine-grained token with no permissions is enough. Stays on the server.
# GITHUB_TOKEN=
# The mod indexes to list on /mods, comma separated. Default: rac1-mods' signed index.
# MOD_INDEXES=https://github.com/OpenRAC/rac1-mods/releases/download/index/index.json
# Folder where the server keeps mod pictures once fetched (the container uses /data/mods-media). Default: none,
# so each picture is fetched from the mod index on every request that misses the browser cache.
# MEDIA_DIR=
