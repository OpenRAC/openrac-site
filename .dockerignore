# Only what `npm run build` needs goes into the build context.
node_modules
.next
.git
.github
.env*
deploy
scripts
# Only the news data goes into the image, not its tools.
news/tools
news/config
news/prompts
news/*.md
coverage
*.log
*.md
Containerfile
.containerignore
.dockerignore
# Card backdrops are game screenshots: never baked into the image, mounted at /data/img instead.
public/img
# The mod docs' generator stays out of the image; its data goes in.
mod-docs/tools
