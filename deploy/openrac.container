# Quadlet unit for the OpenRAC website.
#
# 1. Build the image once (and again after every update):
#      podman build -t localhost/openrac:latest .
# 2. Rootless:  copy this file to ~/.config/containers/systemd/
#    Rootful:   copy it to /etc/containers/systemd/
# 3. systemctl --user daemon-reload && systemctl --user start openrac.service
#    (for a rootful install use `systemctl` without --user)
#
# Rootless: run `loginctl enable-linger $USER` once so it starts at boot without a login.
#
# The app listens on 127.0.0.1:3000; put your reverse proxy (Caddy, nginx, ...) in front of it.

[Unit]
Description=OpenRAC website (Next.js)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/openrac:latest
Pull=never
ContainerName=openrac
PublishPort=127.0.0.1:3000:3000

# Public address, used for absolute URLs in page metadata.
Environment=SITE_URL=https://openrac.dev
# GitHub access (activity feed, Download panel, /mods/submit checks, mod comments). Best: the OpenRAC
# GitHub App, which needs no renewing (README, "GitHub access"). Its settings go in the env file
# (GITHUB_APP_ID, optionally GITHUB_APP_INSTALLATION_ID) and its private key in a Podman secret:
#   podman secret create openrac-github-app ~/openrac-github-app.pem   (then delete the .pem)
# Without the app, GITHUB_TOKEN=... in the env file works too. Create the file first (the unit does not
# start if it is missing), then uncomment what you use:
#EnvironmentFile=%h/.config/openrac/openrac.env
#Secret=openrac-github-app,type=mount,target=/run/secrets/github-app.pem,mode=0400,uid=1000
#Environment=GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem

# Card backdrops: a folder on this machine with rac1-bg.webp, rac1us-bg.webp, gc-bg.webp, uya-bg.webp, deadlocked-bg.webp, going-mobile-bg.webp, size-matters-bg.webp and sac-bg.webp.
# Drop files in (or replace them); no rebuild or restart is needed. They are not in the
# repository because they are game screenshots. ":z" lets SELinux (Fedora, RHEL) allow the read.
Volume=%h/openrac-img:/data/img:ro,z

# Mod pictures (screenshots, banners, icons of the listed mods): fetched once from the mod index's
# release and kept here, so later visits are served from disk and keep working if GitHub is down.
# Writable by the app. Every file is named by its content hash and never changes; the folder can be
# emptied at any time (pictures are fetched again as visitors need them).
Volume=%h/openrac-mods-media:/data/mods-media:rw,Z,U

# Hardening: nothing in the image needs to be writable except the page cache and the mod pictures.
ReadOnly=true
Tmpfs=/tmp
# Pages Next rebuilds in the background (every few minutes) are saved here. In memory: a restart after
# a new build must start from that build's pages, never from an older build's saved copies.
Tmpfs=/app/.next/server/route-cache:rw,mode=1777
Volume=openrac-cache:/app/.next/cache
NoNewPrivileges=true
DropCapability=ALL

HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/healthz
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=restart

[Service]
# The folder must exist before the container starts.
ExecStartPre=/usr/bin/mkdir -p %h/openrac-img %h/openrac-mods-media
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
